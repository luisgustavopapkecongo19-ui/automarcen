rules_version = '2';
// Regras do Firestore do AutoMarcen: cada pessoa só lê e grava a própria pasta users/{uid}.
// Para aplicar: console do Firebase → Firestore Database → Regras → colar tudo → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // todo o resto fica fechado
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
